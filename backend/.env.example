# PNMP Backend Configuration
# Copy this file to .env and update values

# Application
APP_NAME=PNMP
APP_ENV=development
APP_VERSION=1.0.0
APP_SECRET_KEY=change-this-to-random-secret-key-min-32-chars
APP_DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://pnmp:password@localhost:5432/pnmp

# JWT Authentication
JWT_SECRET_KEY=change-this-to-another-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Credential Encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PNMP_ENCRYPTION_KEY=

# Monitoring
MONITORING_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3
MONITORING_MAX_CONCURRENCY=10
METRICS_RETENTION_DAYS=30

# SNMP
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# Aruba API
ARUBA_API_TIMEOUT=10

# Zabbix (Optional)
ZABBIX_URL=
ZABBIX_API_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
